worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    client_body_temp_path /tmp/nginx_client_temp;
    proxy_temp_path /tmp/nginx_proxy_temp;
    fastcgi_temp_path /tmp/nginx_fastcgi_temp;
    uwsgi_temp_path /tmp/nginx_uwsgi_temp;
    scgi_temp_path /tmp/nginx_scgi_temp;
    server {
        listen ${PORT};
        server_name _;
        auth_basic "Chrome Server";
        auth_basic_user_file /tmp/nginx.htpasswd;
        location = /healthz { auth_basic off; default_type text/plain; return 200 "ok\n"; }
        location = /api/status { auth_basic off; proxy_pass http://127.0.0.1:4444/status; proxy_set_header Host $host; }
        location /dashboard/ { auth_basic off; root /opt/dashboard; try_files $uri $uri/ /dashboard/index.html; }
        location /mcp {
            proxy_pass http://127.0.0.1:${MCP_PORT}/mcp;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location /wd/hub/ {
            proxy_pass http://127.0.0.1:4444/wd/hub/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }
        location = /status { proxy_pass http://127.0.0.1:4444/status; proxy_set_header Host $host; proxy_read_timeout 30s; }
        location /websockify {
            auth_basic off;
            proxy_pass http://127.0.0.1:7900/websockify;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
        }
        location / { proxy_pass http://127.0.0.1:7900/; proxy_set_header Host $host; }
    }
}